# Client ID of your Spotify app (32 hex characters, no client secret needed).
# Create an app at https://developer.spotify.com/dashboard and add the redirect URI below to it.
SPOTIFY_CLIENT_ID=your-spotify-client-id

# setlist.fm API key, NOT a Spotify credential (usually xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx).
# Apply for one at https://www.setlist.fm/settings/apps
SETLIST_API_KEY=your-setlist-fm-api-key

# Optional, must exactly match a redirect URI on your Spotify app (Spotify requires 127.0.0.1,
# not localhost). Defaults to http://127.0.0.1:8888/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
